rules_version = '2';

// กฎความปลอดภัยของฐานข้อมูลบัญชีขนมบ้านเพลง
// วางทั้งหมดนี้ใน Firebase Console > Firestore Database > Rules แล้วกด Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(memberDoc()); }
    function isOwner() { return isMember() && get(memberDoc()).data.role == 'owner'; }
    function settingsDoc() { return /databases/$(database)/documents/meta/settings; }
    function closedMonths() { return exists(settingsDoc()) ? get(settingsDoc()).data.get('closed', []) : []; }
    function myEmail() { return request.auth.token.email.lower(); }
    // หน้าที่ของพนักงาน (เจ้าของร้านทำได้ทุกอย่าง) ถ้าไม่ได้กำหนด = เบิกใช้อย่างเดียว
    function myPerms() { return get(memberDoc()).data.get('perms', {'stockUse': true}); }
    function can(p) { return isMember() && (isOwner() || myPerms().get(p, false) == true); }
    function validPerms(d) { return !('perms' in d) || d.perms.keys().hasOnly(['acct', 'stockIn', 'stockUse', 'stockCount']); }

    // เจ้าของร้าน: บัญชีแรกที่กด "ฉันคือเจ้าของร้าน" (ทำได้ครั้งเดียว)
    match /meta/owner {
      allow get: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/owner)
        && request.resource.data.uid == request.auth.uid;
    }

    // ชื่อร้าน บัญชีเงิน หมวด ยอดตั้งต้น เดือนที่ปิดงวด
    match /meta/settings {
      allow read: if can('acct');
      allow write: if isOwner();
    }

    // ผู้ใช้งาน: เจ้าของร้านหลัก + เจ้าของร้านหรือพนักงานที่ได้รับเชิญ
    function founderUid() { return get(/databases/$(database)/documents/meta/owner).data.uid; }
    function inviteDoc() { return /databases/$(database)/documents/invites/$(myEmail()); }
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read: if isOwner();
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid)
        || (request.resource.data.role in ['owner', 'staff']
          && request.auth.token.email_verified == true
          && exists(inviteDoc())
          && get(inviteDoc()).data.role == request.resource.data.role
          && request.resource.data.get('perms', null) == get(inviteDoc()).data.get('perms', null)
          && request.resource.data.email == myEmail())
      );
      // เจ้าของร้านเปลี่ยนสิทธิ์คนอื่นได้ แต่เปลี่ยนของตัวเองหรือของเจ้าของร้านหลักไม่ได้
      allow update: if isOwner() && uid != request.auth.uid && uid != founderUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleAt', 'roleBy', 'perms'])
        && request.resource.data.role in ['owner', 'staff'] && validPerms(request.resource.data);
      allow delete: if isOwner() && uid != request.auth.uid && uid != founderUid();
    }

    // คำเชิญ (ชื่อเอกสาร = อีเมลตัวพิมพ์เล็ก)
    match /invites/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && request.resource.data.role in ['owner', 'staff'] && validPerms(request.resource.data);
    }

    // รายการบัญชี เก็บวันละ 1 เอกสาร ชื่อเอกสาร = วันที่ เช่น 2026-10-22
    // เดือนที่ปิดงวดแล้ว เพิ่ม แก้ไข หรือลบไม่ได้
    match /days/{date} {
      allow read: if can('acct');
      allow create, update: if can('acct')
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.m is string
        && request.resource.data.m.matches('^[0-9]{4}-[0-9]{2}$')
        && date.matches(request.resource.data.m + '-[0-9]{2}')
        && request.resource.data.d == date
        && !(request.resource.data.m in closedMonths())
        && (resource == null || !(resource.data.m in closedMonths()));
      allow delete: if false;
    }

    // ลูกค้าและเจ้าหนี้
    match /contacts/{id} {
      allow read, create, update: if can('acct');
      allow delete: if isOwner();
    }

    // รูปใบเสร็จ
    match /receipts/{id} {
      allow read: if can('acct');
      allow create: if can('acct') && request.resource.data.by == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if isOwner();
    }

    // สต็อกวัตถุดิบ: เจ้าของร้านเพิ่ม/แก้รายการ พนักงานเปลี่ยนได้แค่จำนวนคงเหลือ
    match /stock/{id} {
      allow read: if isMember();
      allow create, delete: if isOwner();
      // พนักงานเปลี่ยนได้แค่จำนวนคงเหลือ: รับเข้า = เพิ่ม, เบิกใช้ = ลด, นับสต็อก = ปรับได้ทั้งสองทาง
      allow update: if isOwner()
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'upd'])
            && ((can('stockIn') && request.resource.data.qty > resource.data.qty)
              || (can('stockUse') && request.resource.data.qty < resource.data.qty)
              || can('stockCount')));
    }
    // ราคาและมูลค่าสต็อก: เจ้าของร้านเท่านั้น
    match /stockcost/{id} {
      allow read, write: if isOwner();
    }
    match /stockvals/{month} {
      allow read, write: if isOwner();
    }
    // ประวัติรับเข้า/เบิกใช้/ปรับจากการนับ: เพิ่มได้อย่างเดียว
    match /stockmoves/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == request.auth.uid
        && (isOwner()
          || (request.resource.data.t == 'in' && can('stockIn'))
          || (request.resource.data.t == 'use' && can('stockUse'))
          || (request.resource.data.t == 'adj' && can('stockCount')));
    }
    // การนับสต็อกรายเดือน: นับได้ระหว่างเปิดอยู่ เจ้าของร้านปิด/เปิดได้
    match /stockcounts/{month} {
      allow read: if isMember();
      allow create: if can('stockCount') && request.resource.data.status == 'open';
      allow update: if isOwner()
        || (can('stockCount') && resource.data.status == 'open' && request.resource.data.status == 'open');
    }

    // ประวัติการแก้ไข: เพิ่มได้อย่างเดียว แก้หรือลบไม่ได้ เจ้าของร้านอ่านได้
    match /audit/{id} {
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow read: if isOwner();
    }
  }
}
